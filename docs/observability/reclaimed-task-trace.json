          }
         },
         {
          "key": "db.query.text",
          "value": {
           "stringValue": "\n    with picked as (select unnest($6::uuid[]) as id),\n    leased as (\n      update tasks t\n         set state = 'LEASED', lease_epoch = greatest(t.lease_epoch, coalesce(t.spec_epoch, 0)) + 1, worker_id = $1,\n             lease_expires_at = now() + ($2::int * interval '1 millisecond'),\n             started_at = now(), queued = false,\n             pushed_at = case when $5::boolean then now() else t.pushed_at end,\n             eligible_at = case when $5::boolean then now() else t.eligible_at end\n        from picked\n       where t.id = picked.id and t.state = 'PENDING'\n         and exists (select 1 from workers w where w.id = $1 and w.status = 'ALIVE' and w.stage = t.stage)\n      returning t.id, t.lease_epoch, t.stage, t.image_id, t.enqueued_at, t.traceparent\n    ),\n    logged as (\n      insert into task_events (task_id, worker_id, type, detail)\n      select id, $1, 'claimed', jsonb_build_object('leaseEpoch', lease_epoch) from leased\n    )\n    select l.id, l.lease_epoch, l.stage, i.sha256, i.object_key, coalesce(j.country_code, $3) as country_code,\n           d.detections, l.traceparent\n      from leased l\n      join images i on i.id = l.image_id\n      join jobs j on j.id = i.job_id\n      left join detection_results d on l.stage = 'classify' and d.sha256 = i.sha256 and d.model_version = $4\n     order by l.enqueued_at, l.id"
          }
         },
         {
          "key": "server.address",
          "value": {
           "stringValue": "postgres"
          }
         }
        ],
        "status": {}
       },
       {
        "traceId": "yUZiix6KoS4amuWapFzLQA==",
        "spanId": "jcAYWHXczn0=",
        "parentSpanId": "YmYnOlRufwY=",
        "name": "pg.query:WITH wildebeest",
        "kind": "SPAN_KIND_CLIENT",
        "startTimeUnixNano": "1790377182751000000",
        "endTimeUnixNano": "1790377182752089667",
        "attributes": [
         {
          "key": "db.system.name",
          "value": {
           "stringValue": "postgresql"
          }
         },
         {
          "key": "db.namespace",
          "value": {
           "stringValue": "wildebeest"
          }
         },
         {
          "key": "server.port",
          "value": {
           "intValue": "5432"
          }
         },
         {
          "key": "db.query.text",
          "value": {
           "stringValue": "with pushed as (\n       update tasks set queued = true, pushed_at = now(),\n                        eligible_at = case when $4::timestamptz is null or greatest(pending_at, not_before) >= $4\n                                           then greatest(pending_at, not_before) else $5 end\n        where id in (select id from tasks\n                      where state = 'PENDING' and stage = $1 and queued = false\n                        and (started_at is not null) = $3\n                        and (not_before is null or not_before <= now())\n                      order by enqueued_at, id\n                      limit $2\n                      for update skip locked)\n        returning id, stage, enqueued_at\n     )\n     select id, stage from pushed order by enqueued_at, id"
          }
         },
         {
          "key": "server.address",
          "value": {
           "stringValue": "postgres"
          }
         }
        ],
        "status": {}
       }
      ]
