    {
      "type": "timeseries",
      "title": "Completions / s",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Accepted completions per second (fenced-off writes excluded).",
      "interval": "5s",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (stage) (rate(wildebeest_tasks_completed_total[30s]))",
          "legendFormat": "{{stage}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors / s",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
